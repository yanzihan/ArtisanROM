#bluetooth.profile.bas.client.enabled?=false
# Removed by post_process_props.py because overridden by bluetooth.profile.csip.set_coordinator.enabled=true
#bluetooth.profile.csip.set_coordinator.enabled?=false
bluetooth.profile.gatt.enabled=true
# Removed by post_process_props.py because overridden by bluetooth.profile.hap.client.enabled=true
#bluetooth.profile.hap.client.enabled?=false
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.map.server.enabled=true
# Removed by post_process_props.py because overridden by bluetooth.profile.mcp.server.enabled=true
#bluetooth.profile.mcp.server.enabled?=false
bluetooth.profile.opp.enabled=false
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.pbap.server.enabled=true
bluetooth.profile.sap.server.enabled=true
# Removed by post_process_props.py because overridden by bluetooth.profile.ccp.server.enabled=true
#bluetooth.profile.ccp.server.enabled?=false
# Removed by post_process_props.py because overridden by bluetooth.profile.vcp.controller.enabled=true
#bluetooth.profile.vcp.controller.enabled?=false
# SS_GAP_FEATURE - GAP_210 : Set AUTO_ON property with default false
bluetooth.server.automatic_turn_on=true
# SS_GAP_FEATURE END
# SS_GAP_FEATURE - GAP_042
bluetooth.device_id.vendor_id=0x0075
bluetooth.device_id.product_id=0x0100
bluetooth.device_id.product_version=0x0201
# SS_GAP_FEATURE END
# Codec capabilities that support a2dp offload
persist.bluetooth.samsung.a2dp_offload.cap=sbc-aptx-ssc-hifi
# SS_A2DP_FEATURE
bluetooth.profile.a2dp.sink.enabled=false
bluetooth.profile.avrcp.controller.enabled=false
persist.bluetooth.samsung.a2dp.version=1.3
persist.bluetooth.samsung.a2dp.cap=SBC,AAC,APTX,LDAC,SSC,UHQ
persist.bluetooth.samsung.avrcp.version=1.6
persist.bluetooth.samsung.avrcp.features=METADATA,ABSOLUTE_VOLUME,BROWSE,COVERART
# SS_BLE_FEATURE
bluetooth.core.le.max_number_of_concurrent_connections=16
# SS_BT_HFP - H_369 : enable answer_call_with_video
bluetooth.hfp.answer_call_with_video.enabled=true
# SS_BT_HFP - H_369 end
#  SS_BT_LEA - T_046 : Interleaved arrangement for CIS
